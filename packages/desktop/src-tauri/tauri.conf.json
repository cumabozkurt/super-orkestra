{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Orkestra",
  "version": "1.0.1",
  "identifier": "dev.superorkestra.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Super Orkestra",
        "width": 1100,
        "height": 780
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cuma Bozkurt",
    "shortDescription": "AI kodlama orkestratörü",
    "license": "MIT"
  }
}
